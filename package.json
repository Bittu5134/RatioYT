{
  "private": true,
  "name": "ratioyt",
  "version": "1.1.0",
  "description": "Brings like/dislike ratios back to YouTube video cards and filters low-rated videos.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "author": {
    "name": "Bittu",
    "email": "hello@bittu.dev",
    "url": "https://bittu.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bittu5134/RatioYT.git"
  },
  "homepage": "https://ratioyt.bittu.dev",
  "keywords": [
    "browser-extension",
    "webextension",
    "youtube",
    "return-youtube-dislike",
    "extension.js"
  ],
  "scripts": {
    "dev": "extension dev --browser=chrome",
    "preview": "extension preview --browser=chrome",
    "build": "extension build --browser chrome",
